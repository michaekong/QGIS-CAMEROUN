.hero-image .hero-container img{max-width:calc(min(50vw,200px));margin-bottom:60px}.content ul{color:#4d6370}.context-container .navbar{background-color:unset;min-height:3em}.context-container .navbar-burger{color:#fff;margin-left:unset;width:3em;height:3em}.context-container .navbar-start .navbar-item{color:#fff;border-radius:5px}.context-container .navbar-start .navbar-item,.context-container .navbar-start .nabar-link{padding:.5rem .75rem}.context-container .navbar-start a.navbar-item.is-active,.context-container .navbar-start .navbar-link.is-active,.context-container .navbar-start .navbar-item{color:#fff;background-color:unset}.context-container .navbar-start a.navbar-item.is-active:hover,.context-container .navbar-start .navbar-link.is-active:hover,.context-container .navbar-start .navbar-item:hover{color:#0a0a0a;background-color:#fafafa}.context-container .navbar-start .navbar-link{color:inherit;border-radius:5px}.context-container .navbar-brand,.context-container .navbar-tabs{min-height:unset}.context-container .navbar-brand a:hover,.context-container .navbar-tabs a:hover{color:#fff}.context-container input{background:#223745;border:none;width:100%;color:#f3f3f3;padding:.5rem .75rem;border-radius:290486px}.context-container input::placeholder{color:#f3f3f3;opacity:.3}.context-container input:hover{border:none}.context-container input:focus{background:#fff}@media screen and (min-width:1024px){.context-container .navbar-start{padding:10px 0}.context-container .navbar-start .navbar-dropdown{background-color:#002033;border:none}}@media screen and (max-width:1023px){.context-container .container{max-width:unset}.context-container .box{padding:1.25rem 1rem 1.25rem 0}.context-container .navbar-menu{background-color:#002033;min-width:150px;padding:1rem}.context-container .navbar-menu.is-active{display:block;position:fixed;height:calc(100% - 112px);overflow:auto;left:0;animation:slideInFromLeft .3s ease-out forwards}.context-container .navbar-menu:not(.is-active){animation:slideOutToLeft .3s ease-out forwards}@keyframes slideInFromLeft{from{transform:translateX(-100%);opacity:0}to{transform:translateX(0);opacity:1}}@keyframes slideOutToLeft{from{transform:translateX(0);opacity:1}to{transform:translateX(-100%);opacity:0}}.context-container .context-container .navbar-start a.navbar-item.is-active:hover,.context-container .context-container .navbar-start .navbar-link.is-active:hover,.context-container .context-container .navbar-start .navbar-item:hover{background-color:unset!important;color:#fff!important}.context-container .content>.columns .content{width:100%}}@media screen and (min-width:1408px){.context-container .search-control{margin-right:60px}}@media screen and (max-width:1023px){.box{padding:1.25rem 1rem 1.25rem 0}}